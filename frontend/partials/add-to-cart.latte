<form
  action="/rc/add-to-cart"
  class="add-to-cart"
  data-pricing="{$product->frontendPricing()}"
  {alfred()}
>
  <input type='hidden' name='product' value='{$product}'>
  {$rc->view('partials/add-to-cart-price', ['product' => $product])}
  {$rc->view('partials/add-to-cart-variations', ['product' => $product])}
  {$rc->view('partials/add-to-cart-accessories', ['product' => $product])}
  {$rc->view('partials/add-to-cart-amount', ['product' => $product])}
  <input
    type="submit"
    class="uk-margin uk-button uk-button-primary uk-width-1-1"
    value="Add to cart"
  />
</form>
<script>
console.log(JSON.parse({$product->frontendPricing()}));
</script>