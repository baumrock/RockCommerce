{var $accessories = $product->accessories()}
{exitIf !$accessories->count()}

<h4>{=__('Accessories')}</h4>
{foreach $accessories as $acc}
<div>
  <label>
    <input type="checkbox" name="acc_{$acc}" class="uk-checkbox" rc-accessory="{$acc->id}">
    {$acc->title}
    <small>{$acc->price()}</small>
  </label>
</div>
{/foreach}
