<div id="cart-sidebar">
  <div
    class="uk-card uk-card-default uk-card-small"
    uk-sticky="offset: 20; bottom: true; media: @m;"
  >
    <div class="uk-card-body">
      <h3 class="uk-margin-remove uk-visible@m">
        <svg style="margin-top: -3px" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0m11 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/><path d="M17 17H6V3H4"/><path d="m6 5l14 1l-1 7H6"/></g></svg>
        {=__('Cart')}
      </h3>
      <p class="uk-margin-small-top">
        {$rc->cart()->items()->count()}
        {=__('Items')}
      </p>
      <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand uk-text-muted uk-first-column">{=__('Subtotal')}</div>
        <div>$3148</div>
      </div>
      <div class="uk-grid-small" uk-grid>
        <div class="uk-width-expand uk-text-muted uk-first-column">{=__('Discount')}</div>
        <div class="uk-text-danger">−$29</div>
      </div>
    </div>
    <hr class="uk-margin-remove">
    <div class="uk-card-body">
      <div class="uk-grid-small uk-flex-middle" uk-grid>
        <div class="uk-width-expand uk-text-muted uk-first-column">{=__('Total')}</div>
        <div class="uk-text-lead uk-text-bolder">
          € {rand(0,100)}
        </div>
      </div>
      <a class="uk-button uk-button-primary uk-margin-small uk-width-1-1" href="./checkout">
        {=__('Checkout')}
      </a>
    </div>
  </div>
</div>