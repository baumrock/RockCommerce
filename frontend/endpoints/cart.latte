{var $cart = $rc->getCart()}

{$rc->view('partials/header')}

<div class="uk-container" {alfred()}>
  <div class="uk-child-width-1-1 uk-grid-small uk-grid" uk-grid>
    <div class="uk-width-expand@m">
      <div class="uk-card uk-card-default uk-card-small">
        <div class="uk-card-body">
          {$rc->view('partials/cart-items')}
        </div>
        <div n:if="$cart && $cart->editable()" class="uk-text-center uk-section-xsmall">
          <a href="{$cart->editUrl()}">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M7 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1"/><path d="M20.385 6.585a2.1 2.1 0 0 0-2.97-2.97L9 12v3h3l8.385-8.415zM16 5l3 3"/></g></svg>
            {=__('Edit Cart')}
          </a>
        </div>
      </div>
    </div>
    {$rc->view('partials/cart-sidebar')}
  </div>
</div>

{$rc->view('partials/footer')}
