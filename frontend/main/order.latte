{do $site->licenseLogin("order")}
{var $order = $rockcommerce->getOrder($site->hasLicense())}
<div class="uk-text-center">
  {if $order}
    {switch $status = $order->paymentstatus(1)}
      {case "paid"}
        <h2>{__('Thank you for your business!')}</h2>
        <p>An invoice has been sent to <strong>foo@bar.com</strong>.</p>
        <hr>
        <p class="uk-margin-small-bottom uk-text-bold">
          {__('Status of your order')}
        </p>
        <div class="uk-alert uk-alert-success uk-text-bold uk-margin-small-top uk-margin-remove-bottom">
          {$status}
        </div>
        <hr>
        <div class="uk-margin">
          <a
            href="{$rockcommerce->url('download')}"
            class="uk-button uk-button-primary uk-width-1-1">
            Proceed to download
          </a>
        </div>
      {default}
        <p class="uk-margin-small-bottom uk-text-bold">
          {__('Status of your order')}
        </p>
        <div class="uk-alert uk-text-bold uk-margin-small-top uk-margin-remove-bottom">
          {$status}
        </div>
    {/switch}
  {else}
    <div class="uk-alert uk-alert-danger uk-text-bold">
      {__('Invalid order ID')}
    </div>
  {/if}
</div>