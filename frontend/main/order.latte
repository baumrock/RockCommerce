{do $site->licenseLogin("order")}
{var $order = $rockcommerce->getOrder($site->hasLicense())}
<div class="uk-text-center">
  {if $order}
    {switch $status = $order->paymentstatus(1)}
      {case "paid"}
        <h2>{__('Thank you for your business!')}</h2>
        <p>The invoice has been sent to <strong>{$order->email()}</strong></p>
        <hr>
        <p class="uk-margin-small uk-text-small">
          {__('Status of your order')}
        </p>
        <div class="uk-alert uk-alert-success uk-text-bold uk-margin-small-top uk-margin-remove-bottom">
          {$status}
        </div>
        <hr>
        <div class="uk-margin">
          <a
            href="{$rockcommerce->url('download')}"
            class="uk-button uk-button-primary uk-width-1-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9V5.414a1 1 0 0 1 1.707-.707l6.586 6.586a1 1 0 0 1 0 1.414l-6.586 6.586A1 1 0 0 1 12 18.586V15H6V9h6zM3 9v6"/></svg>
            Proceed to download
          </a>
        </div>
      {default}
        <p class="uk-margin-small uk-text-small">
          {__('Status of your order')}
        </p>
        <div class="uk-alert uk-text-bold uk-margin-small-top uk-margin-remove-bottom">
          {$status}
        </div>
    {/switch}
  {else}
    <div class="uk-alert uk-alert-danger uk-text-bold">
      {__('Invalid order ID')}
    </div>
  {/if}
</div>