# block public access to all files
# add exceptions as needed
<IfModule mod_rewrite.c>
    RewriteEngine On

    # allow access to js/css files in dst folder
    RewriteCond %{REQUEST_FILENAME} !^.*/dst/.*\.(js|css)$

    # allow access to files in /lib folder
    RewriteCond %{REQUEST_FILENAME} !^.*/lib/.*\.(js|css)$

    # allow access to files in /site/modules/RockCommerce/RockGrid folder
    RewriteCond %{REQUEST_FILENAME} !^.*/RockGrid/.*\.(js|css)$

    # 403 forbidden
    RewriteRule ^ - [F,L]
</IfModule>
